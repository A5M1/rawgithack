{
  "name": "rawgithack-vercel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "description": "Custom fork of rawgithack with a Vercel/Express adapter",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev": "npm run build:dev && node --env-file-if-exists=.env.local server.js",
    "start": "node --env-file-if-exists=.env.local server.js",
    "deploy": "vercel deploy",
    "test": "node --test",
    "create-user": "node scripts/create-user.js",
    "check-db": "node --env-file-if-exists=.env.local scripts/check-db.js",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "express": "^5.3.0",
    "mongodb": "^7.9.1"
  },
  "devDependencies": {
    "webpack": "^5.113.0",
    "webpack-cli": "^6.0.1"
  }
}
