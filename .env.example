# ---------------------------------------------------------------------------
# rawgit.hack environment variables
#
# Copy this file to .env.local for local development, or add these keys in the
# Vercel project settings. Never commit real credentials.
# ---------------------------------------------------------------------------

# Public domain configuration.
#
# Leave both empty to serve from the deployment host (for example
# https://project.vercel.app) using path prefixes like /cdn/... and /gl/...
#
# Set GITHACK_BASE_DOMAIN when using your own domain with platform subdomains:
#   raw.example.com, rawcdn.example.com, gl.example.com, ...
GITHACK_BASE_DOMAIN=
# Defaults to raw.<GITHACK_BASE_DOMAIN>. Set to the apex if you want the main
# host to be example.com instead of raw.example.com.
GITHACK_CANONICAL_HOST=

# Optional branding and footer source link.
# Defaults to the base domain above and the upstream GitHub repository.
GITHACK_SITE_NAME=
GITHACK_SOURCE_URL=

# Optional: template directory. Defaults to ./web
# GITHACK_WEB_ROOT=web

# Required for the dashboard, authentication and short links.
# Use a rotated password and URL-encode special characters.
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=githack

# Enables one-time registration at /register/<REGISTRATION_SECRET>.
# Leave empty to disable registration.
REGISTRATION_SECRET=

# Local development only. Vercel sets its own PORT.
PORT=3000
